---
import { Image } from "astro:assets";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Navbar from "@/components/Navbar.astro";
import CloudBand from "@/components/CloudBand.astro";
import { DownloadButton } from "@/components/DownloadButton";
import { buttonVariants } from "@/components/ui/button";
import { getLatestRelease, getDownloadForOs } from "@/lib/releases";
import { site } from "@/lib/site";
import { cn } from "@/lib/utils";

const latest = await getLatestRelease();
const windows = getDownloadForOs(latest, "windows");
const linux = getDownloadForOs(latest, "linux");
---

<BaseLayout>
  <main class="relative h-dvh overflow-hidden">
    <Image
      src={site.image}
      alt=""
      inferSize
      widths={[640, 1280, 1920]}
      sizes="100vw"
      class="absolute inset-0 size-full object-cover"
      loading="eager"
      fetchpriority="high"
      aria-hidden="true"
    />
    <div class="absolute inset-0 bg-black/15" aria-hidden="true"></div>

    <Navbar variant="hero" />
    <CloudBand />

    <div
      class="hero-content relative z-20 flex h-full flex-col justify-end px-6 pb-16 sm:px-10 sm:pb-20 lg:px-16"
    >
      <div class="mx-auto w-full max-w-4xl text-center sm:text-left">
        <h1
          class="font-heading text-display font-bold tracking-tight text-foreground"
        >
          {site.name}
        </h1>
        <p class="mt-3 max-w-xl text-lead text-foreground/80 sm:mt-4">
          A lightweight free offline ebook reader for TXT, PDF, and EPUB.
        </p>

        <div
          class="mt-8 flex flex-col items-center gap-3 sm:flex-row sm:items-stretch sm:gap-4"
        >
          <DownloadButton
            client:load
            windowsUrl={windows?.url ?? null}
            linuxUrl={linux?.url ?? null}
          />
          <a
            href="/download"
            class={cn(
              buttonVariants({ variant: "outline", size: "xl" }),
              "border-foreground/15 bg-white/80 text-foreground backdrop-blur-sm hover:bg-white",
            )}
          >
            Read more
          </a>
        </div>
      </div>
    </div>
  </main>
</BaseLayout>

<style>
  @keyframes hero-rise {
    from {
      opacity: 0;
      transform: translateY(1.25rem);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .hero-content {
    animation: hero-rise 0.7s ease-out both;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-content {
      animation: none;
    }
  }
</style>
