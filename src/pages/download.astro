---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Navbar from "@/components/Navbar.astro";
import { buttonVariants } from "@/components/ui/button";
import { formatBytes, getReleases, type ReleaseAsset } from "@/lib/releases";
import { site } from "@/lib/site";
import { cn } from "@/lib/utils";

const releases = await getReleases();

function kindLabel(kind: ReleaseAsset["kind"]): string {
  switch (kind) {
    case "exe":
      return "Windows installer (.exe)";
    case "msi":
      return "Windows installer (.msi)";
    case "deb":
      return "Ubuntu / Debian (.deb)";
    case "appimage":
      return "Linux AppImage";
    case "rpm":
      return "Fedora / RHEL (.rpm)";
    default:
      return "Download";
  }
}
---

<BaseLayout
  title="Download Gwuma — Windows & Ubuntu"
  description="Download Gwuma for Windows or Ubuntu/Linux. Lightweight free offline ebook reader for TXT, PDF, and EPUB."
  canonical={`${site.url}/download`}
>
  <div class="relative min-h-dvh bg-[#fffaf6]">
    <div
      class="pointer-events-none absolute inset-x-0 top-0 h-72 bg-[radial-gradient(ellipse_at_top,_rgba(255,107,83,0.18),_transparent_65%)]"
      aria-hidden="true"
    >
    </div>

    <Navbar variant="page" />

    <main
      class="relative z-10 mx-auto max-w-4xl px-6 pb-20 pt-28 sm:px-10 sm:pt-32"
    >
      <p class="text-sm font-medium tracking-wide text-primary uppercase">
        Download
      </p>
      <h1 class="mt-2 text-h1 font-bold tracking-tight text-foreground">
        Get Gwuma for your desktop
      </h1>
      <p class="mt-4 max-w-2xl text-lead text-muted-foreground">
        Choose Windows or Ubuntu/Linux. Installers are currently unsigned — your
        OS may ask you to confirm before opening them.
      </p>

      <div class="mt-12 space-y-14">
        {
          releases.map((release) => (
            <section aria-labelledby={`release-${release.tag}`}>
              <div class="flex flex-wrap items-end justify-between gap-3 border-b border-border pb-4">
                <div>
                  <h2
                    id={`release-${release.tag}`}
                    class="text-h2 font-semibold tracking-tight"
                  >
                    {release.name}
                  </h2>
                  <p class="mt-1 text-sm text-muted-foreground">
                    {release.tag}
                    {release.publishedAt
                      ? ` · ${new Date(release.publishedAt).toLocaleDateString(
                          "en-US",
                          {
                            year: "numeric",
                            month: "short",
                            day: "numeric",
                          },
                        )}`
                      : ""}
                  </p>
                </div>
                <a
                  href={release.htmlUrl}
                  class="text-sm font-medium text-primary hover:underline"
                  target="_blank"
                  rel="noreferrer"
                >
                  View on GitHub
                </a>
              </div>

              <div class="mt-8 grid gap-10 md:grid-cols-2">
                {release.windows.length > 0 && (
                  <div>
                    <h3 class="text-h4 font-semibold text-foreground">
                      Windows
                    </h3>
                    <ul class="mt-4 space-y-3">
                      {release.windows.map((asset, index) => (
                        <li>
                          <a
                            href={asset.url}
                            class={cn(
                              buttonVariants({
                                variant: index === 0 ? "default" : "outline",
                                size: index === 0 ? "xl" : "lg",
                              }),
                              "w-full justify-between gap-4 rounded-full sm:w-auto sm:min-w-[22rem]",
                            )}
                            download
                          >
                            <span class="text-left">
                              <span class="block">{kindLabel(asset.kind)}</span>
                              <span class="block text-xs font-normal opacity-80">
                                {asset.name} · {formatBytes(asset.size)}
                              </span>
                            </span>
                          </a>
                        </li>
                      ))}
                    </ul>
                  </div>
                )}

                {release.linux.length > 0 && (
                  <div>
                    <h3 class="text-h4 font-semibold text-foreground">
                      Ubuntu / Linux
                    </h3>
                    <ul class="mt-4 space-y-3">
                      {release.linux.map((asset, index) => (
                        <li>
                          <a
                            href={asset.url}
                            class={cn(
                              buttonVariants({
                                variant: index === 0 ? "default" : "outline",
                                size: index === 0 ? "xl" : "lg",
                              }),
                              "w-full justify-between gap-4 rounded-full sm:w-auto sm:min-w-[22rem]",
                            )}
                            download
                          >
                            <span class="text-left">
                              <span class="block">{kindLabel(asset.kind)}</span>
                              <span class="block text-xs font-normal opacity-80">
                                {asset.name} · {formatBytes(asset.size)}
                              </span>
                            </span>
                          </a>
                        </li>
                      ))}
                    </ul>
                  </div>
                )}
              </div>
            </section>
          ))
        }
      </div>

      <section
        class="mt-16 border-t border-border pt-12"
        aria-labelledby="features"
      >
        <h2 id="features" class="text-h2 font-semibold tracking-tight">
          What’s in {releases[0]?.tag ?? "v1.0.0"}
        </h2>
        <p class="mt-3 max-w-2xl text-muted-foreground">
          A cleanup first stable release — built to stay light while you read
          offline.
        </p>
        <ul class="mt-8 space-y-3 text-body text-foreground">
          {
            site.features.map((feature) => (
              <li class="flex gap-3">
                <span
                  class="mt-2 size-1.5 shrink-0 rounded-full bg-primary"
                  aria-hidden="true"
                />
                <span>{feature}</span>
              </li>
            ))
          }
        </ul>
      </section>

      <p class="mt-14 text-center sm:text-left">
        <a
          href="/"
          class={cn(
            buttonVariants({ variant: "ghost", size: "lg" }),
            "rounded-full",
          )}
        >
          Back to home
        </a>
      </p>
    </main>
  </div>
</BaseLayout>
